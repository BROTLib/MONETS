<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="Global_Version" Id="{3797a827-d3b1-4e0f-a0e5-b559e455f8aa}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	// Mirrors Beckhoff's own Global_Version.stLibVersion_* pattern (see ST_LibVersion),
	// which only covers Tc2_*/Tc3_* library references, not custom ones -- until now: this
	// GVL uses Beckhoff's own naming exactly, so it merges into a consumer's Global_Version.
	// Kept in sync with <ProjectVersion> in MONETSRuntime.plcproj at release time.
	// SA0033 (unused variable) is a hard error in this project; this constant is meant
	// to be read externally via ADS, never referenced internally, so it's suppressed here.
	{attribute 'analysis' := '-33'}
	stLibVersion_MONETSRuntime : ST_LibVersion := (
		iMajor := 1,
		iMinor := 1,
		iBuild := 0,
		iRevision := 0,
		nFlags := 1,
		sVersion := '1.1.0'
	);
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
