<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MonetsTelescopeAuxiliary" Id="{cb121caa-cba6-4e85-8680-87ba92407bb5}" SpecialFunc="None">
    <Declaration><![CDATA[// MONET/S-specific auxiliary sensors (the sensor set differs from MONET/N). Named apart from HalfBROT's
// FB_TelescopeAuxiliary, which it used to shadow (HalfBROT#29).
FUNCTION_BLOCK FB_MonetsTelescopeAuxiliary
VAR
	tempSensorM1   		AT%I*: INT;
	tempSensorM1cell	AT%I*: INT;
	tempSensorM2   		AT%I*: INT;
	tempSensorFlange	AT%I*: INT;
	fbComm				: I_Comm;
	sensorM1			: MONETcommon.FB_MonetTempSensor;
	sensorM1cell		: MONETcommon.FB_MonetTempSensor;
	sensorM2			: MONETcommon.FB_MonetTempSensor;
	sensorFlange		: MONETcommon.FB_MonetTempSensor;
END_VAR
VAR_OUTPUT
	// only valid while the matching valid flag is TRUE: a broken wire reads -50 C (MONETS#17)
	tempM1				: REAL;
	tempM1cell			: REAL;
	tempM2				: REAL;
	tempFlange			: REAL;
	validM1				: BOOL;
	validM1cell			: BOOL;
	validM2				: BOOL;
	validFlange			: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[sensorM1(iRaw := tempSensorM1, sName := 'TEMP_M1', comm := fbComm);
sensorM1cell(iRaw := tempSensorM1cell, sName := 'TEMP_M1_CELL', comm := fbComm);
sensorM2(iRaw := tempSensorM2, sName := 'TEMP_M2', comm := fbComm);
sensorFlange(iRaw := tempSensorFlange, sName := 'TEMP_FLANGE', comm := fbComm);
tempM1 			:= sensorM1.fTemperature;
tempM1cell 		:= sensorM1cell.fTemperature;
tempM2 			:= sensorM2.fTemperature;
tempFlange 		:= sensorFlange.fTemperature;
validM1 		:= sensorM1.bValid;
validM1cell 	:= sensorM1cell.bValid;
validM2 		:= sensorM2.bValid;
validFlange 	:= sensorFlange.bValid;
]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{0ab38d83-c759-49b4-b051-261f5cd152ad}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains	: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode		: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;	   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbComm := comm;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendTelemetry" Id="{5ed8a466-d7bf-44d5-b9d6-ae006c1229a8}">
      <Declaration><![CDATA[METHOD SendTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[1].NAME', 'TEMP_M1');
IF validM1 THEN
	fbComm.PublishLREAL('telescope', 'dome', 'AUXILIARY.SENSOR[1].VALUE', tempM1);
END_IF
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[1].UNIT', 'C');
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[2].NAME', 'TEMP_M2');
IF validM2 THEN
	fbComm.PublishLREAL('telescope', 'dome', 'AUXILIARY.SENSOR[2].VALUE', tempM2);
END_IF
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[2].UNIT', 'C');
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[3].NAME', 'TEMP_M1_CELL');
IF validM1cell THEN
	fbComm.PublishLREAL('telescope', 'dome', 'AUXILIARY.SENSOR[3].VALUE', tempM1cell);
END_IF
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[3].UNIT', 'C');
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[4].NAME', 'TEMP_FLANGE');
IF validFlange THEN
	fbComm.PublishLREAL('telescope', 'dome', 'AUXILIARY.SENSOR[4].VALUE', tempFlange);
END_IF
fbComm.PublishString('telescope', 'dome', 'AUXILIARY.SENSOR[4].UNIT', 'C');]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_MonetsTelescopeAuxiliary">
      <LineId Id="26" Count="1" />
      <LineId Id="50" Count="1" />
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_MonetsTelescopeAuxiliary.FB_Init">
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FB_MonetsTelescopeAuxiliary.SendTelemetry">
      <LineId Id="7" Count="0" />
